{
  "name": "event-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/pdf-assets.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api:dev": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local",
    "api:deploy": "wrangler deploy",
    "test": "node --test tests/*.test.js",
    "archive": "node scripts/archive.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:e2e": "playwright test",
    "dev:frontend": "vite --host 127.0.0.1",
    "api:node": "node --env-file-if-exists=.env server/node.js",
    "start": "node --env-file-if-exists=.env server/node.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.5.438",
    "proj4": "^2.19.10",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "vite": "^6.4.0",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
